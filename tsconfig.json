{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "module": "nodenext", //esnext
    "composite": true,
    "moduleResolution": "nodenext", //bundler
    "target": "esnext", //esnext
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "paths": {
      "@dictionary/*":["./packages/*/src"]
    },
  },
  "references": [
    {"path": "./packages/i18n"},
    {"path": "./packages/language"},
    {"path": "./packages/morpheme"},
    {"path": "./packages/grapheme"},
    {"path": "./packages/gerund"},
    {"path": "./packages/definition"},
    {"path": "./packages/conjugator"},
    {"path": "./packages/misc"},
    {"path": "./packages/thesaurus"}
  ],
}